{
  "redirects": [
    { "source": "/accueil", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/a-propos", "permanent": true },
    { "source": "/tarif", "destination": "/tarifs", "permanent": true },
    { "source": "/profil-independant", "destination": "/profils/independant-startup", "permanent": true },
    { "source": "/commercant-horeca", "destination": "/profils/commercant-horeca", "permanent": true },
    { "source": "/professionel-sante", "destination": "/profils/professionnel-sante", "permanent": true },
    { "source": "/grande-entreprise", "destination": "/profils/grande-entreprise", "permanent": true },
    { "source": "/promoteur-immobilier", "destination": "/profils/promoteur-immobilier", "permanent": true },
    { "source": "/asbl", "destination": "/structures/asbl", "permanent": true },
    { "source": "/absl", "destination": "/structures/asbl", "permanent": true },
    { "source": "/societe-exploitation", "destination": "/structures/societe-exploitation", "permanent": true },
    { "source": "/societe-management-patrimoniale", "destination": "/structures/societe-management-patrimoniale", "permanent": true },
    { "source": "/societe-moyen", "destination": "/structures/societe-de-moyens", "permanent": true },
    { "source": "/services/declaration-impot", "destination": "/services/declaration-impots", "permanent": true },
    { "source": "/services/departement-comptable", "destination": "/services/departement-comptable-externalise", "permanent": true },
    { "source": "/vente", "destination": "/strategie", "permanent": true },
    { "source": "/vente/:path*", "destination": "/strategie/:path*", "permanent": true },
    { "source": "/tresorerie/investir-tresorerie", "destination": "/tresorerie/investir-sa-tresorerie", "permanent": true },
    { "source": "/tresorerie/optimiser-stock", "destination": "/tresorerie/optimiser-son-stock", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)-[A-Z0-9]{8}\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
