{
  "version": 2,
  "buildCommand": "./vercel-build.sh",
  "outputDirectory": "dist/mfinances/browser",
  "installCommand": "node vercel-install.js",
  "framework": null,
  "functions": {
    "dist/mfinances/browser/server.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "env": {
    "NODE_OPTIONS": "--legacy-peer-deps"
  }
}
